# =============================================================================
# 金融 Multi-Agent 投研系统环境变量配置模板 (.env.example)
# 使用说明：
# 1. 复制本文件重命名为 .env：cp .env.example .env (或在 Windows 下直接复制重命名)
# 2. 填入你的大模型 API_KEY (推荐使用 DeepSeek 或 阿里百炼 Qwen，系统遵循 OpenAI 兼容协议)
# 3. 即使不填写 API_KEY，系统也会自动无缝降级到本地保真量化模拟器，保障全流程正常演示
# =============================================================================

# -----------------------------------------------------------------------------
# 一、 大语言模型网关配置 (推荐 DeepSeek 或 兼容 OpenAI 协议的模型)
# -----------------------------------------------------------------------------
# DeepSeek 官方配置 (推荐，性价比极高):
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_DEFAULT_MODEL=deepseek-chat

# 阿里百炼通义千问配置:
# LLM_API_KEY=your_dashscope_api_key_here
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DEFAULT_MODEL=qwen-plus

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=60

# -----------------------------------------------------------------------------
# 二、 投委会多智能体辩论与仲裁控制参数
# -----------------------------------------------------------------------------
# 多空辩论最大对抗轮次 (防止循环图死循环的递归熔断器)
MAX_DEBATE_ROUNDS=2
# 多空分歧度收敛容差阈值
CONVERGENCE_DELTA=0.15

# -----------------------------------------------------------------------------
# 三、 确定性合规风控硬拦截红线 (一票否决权)
# -----------------------------------------------------------------------------
ENABLE_HARD_GUARDRAILS=true
# 资产负债率硬性警戒上限 (高于 75% 一票否决；持牌金融机构另有 94% 口径)
MAX_DEBT_TO_ASSET_RATIO=0.75
# 利息保障倍数下限 (低于 1.5 判定为偿债高危)
MIN_INTEREST_COVERAGE_RATIO=1.5
# 单周 95% 蒙特卡洛 VaR 最大容忍下行损失率 (大于 18% 触发拦截)
MAX_VAR_TOLERANCE=0.18

# -----------------------------------------------------------------------------
# 四、 稳定性与工程化 (以下均有默认值，可不配置)
# -----------------------------------------------------------------------------
# LLM 应用层重试次数 / 熔断阈值(连续失败次数) / 熔断冷却秒数
LLM_MAX_RETRIES=2
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_RECOVERY=30
# 单次全流程分析总超时(秒)
ANALYSIS_TIMEOUT_SECONDS=120
# 三位专家是否并行执行；出现问题时设为 false 回退串行
PARALLEL_EXPERTS=true
# 为 true 时，行情/财报抓取失败直接报错，而不是降级为离线模拟数据
STRICT_REAL_DATA=false
# 每个客户端每分钟允许的分析/对话请求数
RATE_LIMIT_PER_MINUTE=30
# 前端来源白名单(逗号分隔)；记忆库 SQLite 路径
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# MEMORY_DB_PATH=./data/memory.db

# ---- 确定性决策参数 ----
# 评分→档位阈值(>=强烈买入 / >=逢低增配 / >=中性持有，其余规避)
BAND_STRONG_BUY=7.5
BAND_OVERWEIGHT=6.3
BAND_NEUTRAL=4.8
# 多空辩论对最终得分的最大调整幅度(+-)，保证用户权重始终主导结论
DEBATE_MAX_ADJUST=0.8
